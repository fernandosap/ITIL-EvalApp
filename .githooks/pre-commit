#!/usr/bin/env bash
# Pre-commit hook for the ITIL-EvalApp repo.
#
# Setup (one-time):
#   git config core.hooksPath .githooks
#
# What it does:
#   1. Runs unit/regression tests.
#   2. Syntax-checks application JavaScript.
#   3. Scans staged added lines for accidental secret leaks using the same
#      JavaScript-regex engine as CI, avoiding grep/awk regex dialect drift.
#
# To skip in an emergency: git commit --no-verify
# To silence a false positive: add '# secretscan: ok' on the line.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ -t 1 ]; then
  RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
else
  RED=''; YELLOW=''; GREEN=''; NC=''
fi

say()  { printf '%b==>%b %s\n' "$YELLOW" "$NC" "$*"; }
ok()   { printf '%b✓%b  %s\n' "$GREEN" "$NC" "$*"; }
fail() { printf '%b✗%b  %s\n' "$RED" "$NC" "$*" >&2; }

say "Running unit/regression suite..."
if ! npm run test:unit --silent; then
  fail "Tests failed. Fix the failures above, or 'git commit --no-verify' to skip."
  exit 1
fi
ok "Unit/regression tests pass."

say "Syntax-checking application modules..."
SYNTAX_FAILED=0
while IFS= read -r -d '' f; do
  if ! node --check "$f" >/dev/null 2>&1; then
    fail "Syntax error in $f"
    node --check "$f" 2>&1 | sed 's/^/    /'
    SYNTAX_FAILED=1
  fi
done < <(find server.js lib client shared scripts tests/e2e -type f \( -name '*.js' -o -name '*.cjs' -o -name '*.mjs' \) -print0 2>/dev/null)
if [ "$SYNTAX_FAILED" -ne 0 ]; then
  fail "Fix the syntax errors above before committing."
  exit 1
fi
ok "All JavaScript parses cleanly."

say "Scanning staged changes for secrets..."
if ! npm run scan:secrets:staged --silent; then
  fail "Possible secret(s) detected in staged changes."
  fail "If a match is intentionally harmless, add '# secretscan: ok' on that line and re-stage."
  exit 1
fi
ok "No secret patterns detected."

exit 0
