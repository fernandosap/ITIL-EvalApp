{
  "name": "itil-evalapp",
  "version": "1.0.0",
  "private": true,
  "description": "Academy Exam App with Node middleware and SAP HANA persistence",
  "main": "server.js",
  "scripts": {
    "migrate:runtime": "node scripts/migrate-runtime.mjs",
    "start": "npm run migrate:runtime && node --require ./lib/bootstrap.js server.js",
    "check:env": "node scripts/check-env.mjs",
    "test": "npm run test:unit",
    "test:unit": "NODE_ENV=test node --require ./lib/bootstrap.js --test tests/*.test.js",
    "test:smoke": "NODE_ENV=test node --require ./lib/bootstrap.js scripts/smoke-test.mjs",
    "test:e2e:setup": "npm install --no-save --package-lock=false @playwright/test@1.55.0",
    "test:e2e": "npx playwright test --config=playwright.config.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:postdeploy": "node scripts/post-deploy-smoke.mjs",
    "test:ci": "npm run audit:prod && npm run test:unit && npm run scan:secrets",
    "scan:secrets": "node scripts/secret-scan.mjs --repo",
    "scan:secrets:staged": "node scripts/secret-scan.mjs --staged",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "precommit": "bash .githooks/pre-commit",
    "inspect:hana": "node scripts/inspect-hana.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@sap/hana-client": "^2.25.27",
    "express": "^4.21.2"
  }
}
